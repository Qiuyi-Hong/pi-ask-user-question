{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["upstream/rpiv-ask-user-question/**/*.ts", "tools/**/*.ts", "tests/**/*.ts"],
  "exclude": ["upstream/**/*.test.ts", "upstream/**/test-fixtures.ts"]
}
